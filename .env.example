# Neon Postgres. Use the POOLED string (host contains -pooler) at runtime.
DATABASE_URL=
# Direct (non-pooled) string, used only by drizzle-kit migrate and the seed script.
DATABASE_URL_UNPOOLED=

# Signs the session cookie. At least 32 characters: openssl rand -base64 32
SESSION_SECRET=

# Public address of the site, used for metadata.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional. Order confirmation emails through Resend. Without it, no email is sent.
RESEND_API_KEY=
EMAIL_FROM=Night Owl Books <onboarding@resend.dev>

# Seed only. Password for the admin account that `npm run db:seed` creates.
# If empty, a random one is generated and printed once.
SEED_ADMIN_PASSWORD=
